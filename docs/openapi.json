  },
  "info": {
    "description": "The JSON API of Meerkat CRM. Errors use the AppError format: {\"error\": {\"code\", \"message\", \"details\"}, \"request_id\", \"timestamp\"}.",
    "title": "Meerkat CRM API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/oidc/config": {
      "get": {
        "operationId": "get-oidc-config",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OIDCConfigOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Single sign-on status",
        "tags": [
          "auth"
        ]
      }
    },
    "/contacts/circles": {
      "get": {
        "operationId": "list-circles",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": [
                    "array",
                    "null"
                  ]
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "The distinct circle names of all contacts",
        "tags": [
          "contacts"
        ]
      }
    },
    "/contacts/{id}": {
      "delete": {
        "operationId": "delete-contact",
        "parameters": [
          {
            "description": "The contact's ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "The contact's ID",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Move a contact and its notes, reminders and relationships to the trash",
        "tags": [
          "contacts"
        ]
      }
    },
    "/contacts/{id}/archive": {
      "post": {
        "operationId": "archive-contact",
        "parameters": [
          {
            "description": "The contact's ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "The contact's ID",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Archive a contact and delete its reminders",
        "tags": [
          "contacts"
        ]
      }
    },
    "/contacts/{id}/unarchive": {
      "post": {
        "operationId": "unarchive-contact",
        "parameters": [
          {
            "description": "The contact's ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "The contact's ID",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Restore an archived contact",
        "tags": [
          "contacts"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}
