{
  "components": {
    "schemas": {
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "timestamp"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "additionalProperties": {},
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "OIDCConfigOutputBody": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "description": "Whether single sign-on is configured",
            "type": "boolean"
          },
          "provider_name": {
            "description": "A display name for the provider, present when enabled",
            "type": "string"
          }
        },
        "required": [
          "enabled"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The JSON API of Meerkat CRM. Errors use the AppError format: {\"error\": {\"code\", \"message\", \"details\"}, \"request_id\", \"timestamp\"}.",
    "title": "Meerkat CRM API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/oidc/config": {
      "get": {
        "operationId": "get-oidc-config",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OIDCConfigOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Single sign-on status",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}
