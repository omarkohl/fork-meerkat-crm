      "get": {
        "operationId": "get-oidc-config",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OIDCConfigOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Single sign-on status",
        "tags": [
          "auth"
        ]
      }
    },
    "/contacts": {
      "get": {
        "operationId": "list-contacts",
        "parameters": [
          {
            "description": "Page number, from 1",
            "explode": false,
            "in": "query",
            "name": "page",
            "schema": {
              "description": "Page number, from 1",
              "type": "string"
            }
          },
          {
            "description": "Page size, 1 to 100, default 25",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Page size, 1 to 100, default 25",
              "type": "string"
            }
          },
          {
            "description": "Full-text search over names, nicknames, e-mail addresses and phone numbers",
            "explode": false,
            "in": "query",
            "name": "search",
            "schema": {
              "description": "Full-text search over names, nicknames, e-mail addresses and phone numbers",
              "type": "string"
            }
          },
          {
            "description": "Only contacts in this circle",
            "explode": false,
            "in": "query",
            "name": "circle",
            "schema": {
              "description": "Only contacts in this circle",
              "type": "string"
            }
          },
          {
            "description": "firstname, lastname, id or random; with search and no sort the best match comes first",
            "explode": false,
            "in": "query",
            "name": "sort",
            "schema": {
              "description": "firstname, lastname, id or random; with search and no sort the best match comes first",
              "type": "string"
            }
          },
          {
            "description": "asc or desc, default desc",
            "explode": false,
            "in": "query",
            "name": "order",
            "schema": {
              "description": "asc or desc, default desc",
              "type": "string"
            }
          },
          {
            "description": "true: archived contacts too, after the others when searching",
            "explode": false,
            "in": "query",
            "name": "include_archived",
            "schema": {
              "description": "true: archived contacts too, after the others when searching",
              "type": "string"
            }
          },
          {
            "description": "true: only archived contacts",
            "explode": false,
            "in": "query",
            "name": "archived",
            "schema": {
              "description": "true: only archived contacts",
              "type": "string"
            }
          },
          {
            "description": "Comma-separated field names; only these are filled. photo_thumbnail adds the thumbnail URL",
            "explode": false,
            "in": "query",
            "name": "fields",
            "schema": {
              "description": "Comma-separated field names; only these are filled. photo_thumbnail adds the thumbnail URL",
              "type": "string"
            }
          },
          {
            "description": "Comma-separated: notes, activities, relationships, reminders",
            "explode": false,
            "in": "query",
            "name": "includes",
            "schema": {
              "description": "Comma-separated: notes, activities, relationships, reminders",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List contacts with search, circle filter, sorting and paging",
        "tags": [
          "contacts"
        ]
      },
      "post": {
        "operationId": "create-contact",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedOutputBody"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Create a contact",
        "tags": [
          "contacts"
        ]
      }
    },
    "/contacts/birthdays": {
      "get": {
        "operationId": "upcoming-birthdays",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BirthdaysOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Upcoming birthdays of contacts and relatives",
        "tags": [
          "contacts"
        ]
      }
    },
    "/contacts/circles": {
      "get": {
        "operationId": "list-circles",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": [
                    "array",
                    "null"
                  ]
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "The distinct circle names of all contacts",
        "tags": [
          "contacts"
        ]
      }
    },
    "/contacts/random": {
      "get": {
        "operationId": "random-contacts",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RandomOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Five random contacts",
        "tags": [
          "contacts"
        ]
      }
    },
    "/contacts/{id}": {
      "delete": {
        "operationId": "delete-contact",
        "parameters": [
          {
            "description": "The contact's ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "The contact's ID",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Move a contact and its notes, reminders and relationships to the trash",
        "tags": [
          "contacts"
        ]
      },
      "get": {
        "operationId": "get-contact",
        "parameters": [
          {
            "description": "The contact's ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "The contact's ID",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Comma-separated field names; only these are filled. Unknown names are ignored.",
            "explode": false,
            "in": "query",
            "name": "fields",
            "schema": {
              "description": "Comma-separated field names; only these are filled. Unknown names are ignored.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get a contact, optionally only some fields",
        "tags": [
          "contacts"
        ]
      },
      "put": {
        "operationId": "update-contact",
        "parameters": [
          {
            "description": "The contact's ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "The contact's ID",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Replace the editable fields of a contact",
        "tags": [
          "contacts"
        ]
      }
    },
    "/contacts/{id}/archive": {
      "post": {
        "operationId": "archive-contact",
        "parameters": [
          {
            "description": "The contact's ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "The contact's ID",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Archive a contact and delete its reminders",
        "tags": [
          "contacts"
        ]
      }
    },
    "/contacts/{id}/unarchive": {
      "post": {
        "operationId": "unarchive-contact",
        "parameters": [
          {
            "description": "The contact's ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "The contact's ID",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Restore an archived contact",
        "tags": [
          "contacts"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}
